# Signal index API key
SENTINEL_API_KEY=

# Optional override for the upstream base URL
SENTINEL_API_BASE_URL=

# --- Analysis: scoring API (optional) -----------------------------------
# The Analyze page reads the sentiment column in the data by default. Set
# these to score rows through an API instead. Only SENTIMENT_API_URL is
# required; the rest describe the request and where the score sits in the
# response, so most vendors need no code change.
SENTIMENT_API_URL=
SENTIMENT_API_KEY=
# Display name in the UI
SENTIMENT_API_LABEL=Scoring API
# batch = one request with an array of texts; single = one request per text
SENTIMENT_API_MODE=batch
# Body field holding the text(s)
SENTIMENT_API_INPUT_FIELD=texts
# Extra JSON merged into every request body, e.g. {"model":"sentiment-v2"}
SENTIMENT_API_EXTRA_BODY=
# Where the score is: dotted path, [] steps into an array
SENTIMENT_API_SCORE_PATH=scores[]
# Optional companion path when the API answers with a word plus a confidence
SENTIMENT_API_LABEL_PATH=
# signed (-1..1) | unit (0..1) | label (a word) | label_score (word + confidence)
SENTIMENT_API_SCALE=signed
# Word to score, for the label scales
SENTIMENT_API_LABEL_MAP=positive:1,negative:-1,neutral:0
# Auth header, defaults shown
SENTIMENT_API_AUTH_HEADER=Authorization
SENTIMENT_API_AUTH_PREFIX=Bearer
SENTIMENT_API_BATCH_SIZE=32
SENTIMENT_API_CONCURRENCY=2
SENTIMENT_API_TIMEOUT_MS=20000

# --- Analysis: direct ingest (optional) ---------------------------------
# Restrict which hosts the server will fetch an export from. Empty = any
# public host. Comma-separated suffixes, e.g. exorde.io,amazonaws.com
ANALYZE_URL_ALLOWED_HOSTS=
# Allow fetching from private addresses. Only for self-hosted storage on the
# same network — it lets a typed URL reach inside your network.
ANALYZE_URL_ALLOW_PRIVATE=false
